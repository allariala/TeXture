# ---------------------------------------------------------------
# Build output / IDE state
# ---------------------------------------------------------------
bin/
obj/
.vs/
*.user
*.suo
packages/
node_modules/
__pycache__/
*.pyc
publish/

# Installer output and generated key include
/windows/installer/Output/
/windows/installer/.release-cache/
# Generated third-party notices are distributed in the installer/source asset, not tracked in Git.
/licenses/ocr/
/windows/installer/keys.generated.iss

# PyInstaller work folders (the OCR engine is built locally; see README)
/windows/capture/build/
/windows/capture/dist/
/windows/capture/Backup/
/windows/capture/.vscode/

# Mac web add-in build output
/mac/dist/

# ---------------------------------------------------------------
# Heavy binaries (~3 GB): NN models, bundled OCR server, installers.
# The small model configs/tokenizer (windows/capture/models/*.json) ARE tracked.
# ---------------------------------------------------------------
*.pt
*.safetensors
*.exe
*.pkg
*.pyz

# ---------------------------------------------------------------
# Secrets (code-signing keys never go into git)
# ---------------------------------------------------------------
*.pfx
*.snk

# Local tooling
.claude/

# Local session handover (exclude from source distribution)
/HANDOVER.md

# Additional private-key and local audit artifacts
*.pem
*.key
/SECURITY_REVIEW_LOCAL.md
windows/capture/.venv/
windows/capture/*.local.json
windows/capture/test-stage/
tools/.security-test/
windows/capture/model.sha256

# Release notes are attached to GitHub Releases, not committed
/RELEASE_NOTES_*.md
