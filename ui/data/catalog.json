    { "tex": "\\oint\\limits_{$0}", "keys": "Ctrl+Shift+I, C", "name": "Contour integral, limit below" },
    { "tex": "\\oint_{$0}", "keys": "Ctrl+Shift+I, Alt+C", "name": "Contour integral, subscript" },
    { "g": "calculus", "tex": "\\lim_{$0 \\to $1}", "tpl": "lim", "name": "Limit" },
    { "g": "calculus", "tex": "\\frac{d$0}{d$1}", "glyph": "d/dx", "name": "Derivative" },
    { "g": "calculus", "tex": "\\frac{\\partial $0}{\\partial $1}", "glyph": "∂/∂x", "name": "Partial derivative" },
    { "g": "calculus", "tex": "\\bigcup_{$0}^{$1}", "tpl": "bigcup", "name": "Big union" },
    { "g": "calculus", "tex": "\\bigcap_{$0}^{$1}", "tpl": "bigcap", "name": "Big intersection" },
    { "tex": "\\mathop{$0}\\limits_{$1}^{$2}", "keys": "Ctrl+T, O", "name": "Large operator, both limits" },
