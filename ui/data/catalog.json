{
  "version": 1,
  "notes": "Single source for the palette, ribbon galleries, MathType-style shortcuts and autocomplete. keys follow MathType 7 (Windows) where it has an equivalent; several alternatives are separated by ' or '. In tex, $0 is the first slot (receives the selection), $1.. are further slots. mode: wrap (default when $0 present) | embellish (wraps the selection or the previous character) | insert.",
  "groups": [
    { "id": "structures", "label": "Fractions & Scripts", "short": "a/b" },
    { "id": "brackets", "label": "Brackets", "short": "( )" },
    { "id": "calculus", "label": "Calculus", "short": "∑∫" },
    { "id": "matrices", "label": "Matrices", "short": "[ ]" },
    { "id": "accents", "label": "Accents", "short": "â" },
    { "id": "greek", "label": "Greek", "short": "αβ" },
    { "id": "operators", "label": "Operators", "short": "±×" },
    { "id": "relations", "label": "Relations", "short": "≤≈" },
    { "id": "arrows", "label": "Arrows", "short": "→" },
    { "id": "sets", "label": "Sets & Logic", "short": "∈∀" },
    { "id": "misc", "label": "Misc", "short": "∞∂" }
  ],
  "oneshots": [
    { "keys": "Ctrl+B", "name": "Bold (next character)", "wrap": "\\mathbf{#}" },
    { "keys": "Ctrl+D", "name": "Blackboard bold (next letter)", "wrap": "\\mathbb{#}", "upper": true }
  ],
  "items": [
    { "g": "structures", "tex": "\\frac{$0}{$1}", "tpl": "frac", "keys": "Ctrl+F", "name": "Fraction" },
    { "g": "structures", "tex": "\\tfrac{$0}{$1}", "tpl": "frac", "keys": "Ctrl+T, Shift+F", "name": "Small fraction" },
    { "g": "structures", "tex": "\\dfrac{$0}{$1}", "tpl": "frac", "name": "Display fraction" },
    { "g": "structures", "tex": "{$0}/{$1}", "tpl": "slash", "keys": "Ctrl+/ or Ctrl+T, Alt+/", "name": "Slash fraction" },
    { "tex": "{}^{$0}/_{$1}", "keys": "Ctrl+T, ?", "name": "Small slash fraction" },
    { "g": "structures", "tex": "\\sqrt{$0}", "tpl": "sqrt", "keys": "Ctrl+R", "name": "Square root" },
    { "g": "structures", "tex": "\\sqrt[$0]{$1}", "tpl": "nroot", "keys": "Ctrl+T, N", "name": "n-th root" },
    { "g": "structures", "tex": "^{$0}", "tpl": "sup", "keys": "Ctrl+H", "name": "Superscript" },
    { "g": "structures", "tex": "_{$0}", "tpl": "sub", "keys": "Ctrl+L", "name": "Subscript" },
    { "g": "structures", "tex": "_{$0}^{$1}", "tpl": "subsup", "keys": "Ctrl+J", "name": "Sub- and superscript" },
    { "g": "structures", "tex": "\\overset{$1}{$0}", "tpl": "overset", "keys": "Ctrl+T, Shift+L", "name": "Over-script" },
    { "g": "structures", "tex": "\\underset{$1}{$0}", "tpl": "underset", "keys": "Ctrl+T, Alt+L", "name": "Under-script" },
    { "tex": "\\overset{$1}{\\underset{$2}{$0}}", "keys": "Ctrl+T, L", "name": "Over- and under-script" },
    { "g": "structures", "tex": "\\binom{$0}{$1}", "tpl": "binom", "name": "Binomial" },
    { "g": "structures", "tex": "\\xrightarrow[$1]{$0}", "tpl": "xarrow", "keys": "Ctrl+T, Right", "name": "Labelled right arrow" },
    { "tex": "\\xrightarrow{$0}", "keys": "Ctrl+T, Shift+Right", "name": "Right arrow, text above" },
    { "tex": "\\xrightarrow[$0]{}", "keys": "Ctrl+T, Alt+Right", "name": "Right arrow, text below" },
