    { "tex": "\\left\\langle $0 \\right.", "keys": "Ctrl+T, <", "name": "Left angle only" },
    { "tex": "\\left. $0 \\right\\rangle", "keys": "Ctrl+T, >", "name": "Right angle only" },

    { "g": "calculus", "tex": "\\sum_{$0}^{$1}", "tpl": "sum", "keys": "Ctrl+T, S", "name": "Summation" },
    { "tex": "\\sum", "keys": "Ctrl+T, Shift+S", "name": "Summation, no limits" },
    { "tex": "\\sum_{$0}", "keys": "Ctrl+T, Alt+S", "name": "Summation, lower limit" },
    { "g": "calculus", "tex": "\\prod_{$0}^{$1}", "tpl": "prod", "name": "Product" },
    { "g": "calculus", "tex": "\\coprod_{$0}^{$1}", "tpl": "coprod", "name": "Coproduct" },
    { "g": "calculus", "tex": "\\int_{$0}^{$1}", "tpl": "int", "keys": "Ctrl+I", "name": "Definite integral" },
    { "g": "calculus", "tex": "\\int", "tpl": "intnl", "keys": "Ctrl+Shift+I, !", "name": "Integral" },
