  <!--
    VSTO builds register the add-in in HKCU so F5 debugging works. Command-line builds must not do that:
    the key name equals the installed add-in's, so a build would silently re-point the user's installed
    TeXture at bin\Debug. Registration now happens only inside Visual Studio (or with RegisterAddinOnBuild=true).
  -->
  <Target Name="RegisterOfficeAddin" Condition="'$(VSTO_ProjectType)' == 'Application' And ('$(BuildingInsideVisualStudio)' == 'true' Or '$(RegisterAddinOnBuild)' == 'true')">
    <SetOffice2007AddInRegistration Url="$(AbsolutePathToTheDeploymentManifest)" AddInName="$(TargetName)" OfficeApplication="$(OfficeApplication)" FriendlyName="$(FriendlyName)" Description="$(OfficeApplicationDescription)" LoadBehavior="$(LoadBehavior)" />
  </Target>
  <!-- The shared editor UI is copied next to the add-in for development builds (the installer ships one copy in {app}\ui). -->
  <Target Name="CopySharedUi" AfterTargets="Build">
    <ItemGroup>
      <TeXtureUiFiles Include="..\..\ui\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TeXtureUiFiles)" DestinationFiles="@(TeXtureUiFiles->'$(OutDir)ui\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
