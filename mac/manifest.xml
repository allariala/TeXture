<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  TeXture 2.0 for PowerPoint (Mac / Office on the web).
  The add-in is the shared editor UI (ui/index.html) served over HTTPS. The URLs below assume this
  repository is published with GitHub Pages at https://allariala.github.io/TeXture/ (repository root).
  If you host it elsewhere, replace every "https://allariala.github.io/TeXture/" below.
  The Id is unchanged from 1.x, so this replaces the old add-in.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>736807ec-0351-4800-af21-e114562a63f2</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Allariala</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="TeXture"/>
  <Description DefaultValue="LaTeX equation editor for PowerPoint: live preview, MathType-style shortcuts, snippets, editable vector equations."/>
  <IconUrl DefaultValue="https://allariala.github.io/TeXture/mac/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://allariala.github.io/TeXture/mac/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://allariala.github.io/TeXture/"/>
  <AppDomains>
    <AppDomain>https://allariala.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://allariala.github.io/TeXture/ui/index.html?host=ppt&amp;platform=office"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="TeXtureGroup">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TeXtureTaskpaneButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>TeXtureTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://allariala.github.io/TeXture/mac/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://allariala.github.io/TeXture/mac/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://allariala.github.io/TeXture/mac/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://allariala.github.io/TeXture/ui/index.html?host=ppt&amp;platform=office"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="TeXture"/>
        <bt:String id="Button.Label" DefaultValue="TeXture"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Open the TeXture LaTeX equation editor."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
